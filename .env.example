# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tap_marketplace

# Server
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000

# Visa CLI Registry (Visa CLI agents)
REGISTRY_ORIGIN=https://auth.visacli.sh

# Visa Agent Directory (enabler-registered agents) - optional for MVP
# DIRECTORY_ORIGIN=https://agenticdirectory.visa.com
# DIRECTORY_ORIGIN_SANDBOX=https://sbx.agenticdirectory.visa.com

# Accepted TRIDs (Token Requestor IDs) - comma separated
# Example: "40010030273,40010092347"
ACCEPTED_TRIDS=40010030273

# Policy
ALLOWED_PATH_PREFIXES=/tasks
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Key cache TTL (seconds) - 60s matches Visa CLI revocation window
KEY_CACHE_TTL_SECONDS=60

# Mock mode (no real Tempo/OUSD) - true for local dev
MOCK_PAYMENTS=true

# Logging
LOG_LEVEL=info